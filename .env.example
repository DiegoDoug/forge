# Copy this file to `.env` and fill in the values before running
# `docker compose up --build`.

# Required. The root encryption key for secrets at rest and session signing.
# Generate a strong one with: openssl rand -base64 32
FORGE_MASTER_KEY=

# Port Forge is served on (http://localhost:FORGE_PORT).
FORGE_PORT=8585

# Set to "true" once Forge sits behind HTTPS (a reverse proxy, Tailscale,
# etc). Leave "false" for plain-HTTP LAN/local use — a `Secure` cookie is
# silently dropped by browsers on non-HTTPS origins, which would otherwise
# break login.
FORGE_SESSION_COOKIE_SECURE=false

# --- Optional: vision-LLM assisted Ingest conversion (off by default) ---
# Costs money and requires an API key from an OpenAI-compatible provider.
# FORGE_VISION_ENABLED=1
# FORGE_VISION_API_KEY=
# FORGE_VISION_BASE_URL=

# --- Optional: MCP server for Claude / Claude Code (Phase 11, off by default) ---
# Exposes a scoped Streamable HTTP MCP endpoint at /mcp - search, retrieve,
# CRUD Notes/Documents/Projects, shape the knowledge graph, and persist
# memory across sessions. See docs/MCP_Usage.md for the full tool list and
# forge-docs/implementation/Phase-11-Claude-MCP/ for the design.
# 1. Set FORGE_MCP_ENABLED=true and a high-entropy FORGE_MCP_BOOTSTRAP_TOKEN
#    (e.g. `openssl rand -base64 32`), then `docker compose up -d`.
# 2. Provision a persistent token (the one Claude actually uses - never the
#    bootstrap token itself):
#      curl -X POST http://localhost:${FORGE_PORT:-8585}/api/mcp/tokens \
#        -H "Authorization: Bearer $FORGE_MCP_BOOTSTRAP_TOKEN" \
#        -H "Content-Type: application/json" \
#        -d '{"name": "Claude Code", "scopes": ["forge:read"]}'
#    The response's "token" field is shown exactly once - save it now.
# 3. Set FORGE_MCP_BOOTSTRAP_ENABLED=false and redeploy - this closes
#    provisioning entirely; the persistent token from step 2 keeps working.
# FORGE_MCP_ENABLED=true
# FORGE_MCP_BOOTSTRAP_ENABLED=true
# FORGE_MCP_BOOTSTRAP_TOKEN=
